<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<GenerateResourceAccessModifier>Public</GenerateResourceAccessModifier>
	</PropertyGroup>

	<ItemGroup>
	  <Compile Update="Resource\ResourceErrorMessages.Designer.cs">
	    <DesignTime>True</DesignTime>
	    <AutoGen>True</AutoGen>
	    <DependentUpon>ResourceErrorMessages.resx</DependentUpon>
	  </Compile>
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Update="Resource\ResourceErrorMessages.resx">
			<Generator>ResXFileCodeGenerator</Generator>
			<LastGenOutput>ResourceErrorMessages.Designer.cs</LastGenOutput>
			<AccessModifier>Public</AccessModifier>
		</EmbeddedResource>
	</ItemGroup>

</Project>
